# ClinicFlow Environment Configuration
# Copy this file to .env and adjust values as needed.
# All variables are optional; sensible defaults are used if omitted.

# Base directory containing data/, models/, and reports/ (defaults to auto-detected clinicflow/ root)
# CLINICFLOW_HOME=./clinicflow

# Chronological train/test split ratio (0.10 to 0.95, default: 0.80)
CLINICFLOW_TRAIN_TEST_SPLIT=0.80

# Risk classification thresholds for predicted no-show probability (0.0 to 1.0)
CLINICFLOW_LOW_RISK_THRESHOLD=0.20
CLINICFLOW_HIGH_RISK_THRESHOLD=0.50
